# DNS caching ttl seconds
-Dsun.net.inetaddr.ttl=30

# Exit immediately, but gracefully on OOM without skipping heap dump, so that k8 can restart the pod
-XX:+ExitOnOutOfMemoryError

# Crash immediately. Unlike exiting gracefully, crash and generate core dump
###-XX:+CrashOnOutOfMemoryError

# Usual args for containerized app
-Djava.security.egd=file:/dev/./urandom

### Below args are commented out because:
###     Buildpack does a better job in determining these based on available memory, app's platform thread count etc.
###     Note: OCI/Docker images create via Dockerfile can use below file in combination to this file
###           fileName: vmArgs__common_global__containerized__non_buildpack
####-XX:+UseContainerSupport
####-XX:MaxRAMPercentage=75.0
